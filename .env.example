# =============================================================================
# Liquid Upstart — settings
# =============================================================================
# This file holds all the settings for your installation. The easiest way to
# change anything is the dashboard in your web browser, but you can also edit
# this file by hand if you prefer.
#
# Good news: you can leave almost everything blank. Empty values are either
# filled in automatically or simply leave a feature switched off. Only fill in
# the few things you actually want — for example, an AI key in section 5 or your
# own local AI model in section 6.
# =============================================================================


# =============================================================================
# 1. NETWORKING
# =============================================================================
# Which ports the apps are served on in your browser. Leave both blank and the
# installer picks free ones for you — it prints the final web addresses when it
# starts. Only set these if you need specific port numbers.
SYSTEM_HTTP_PORT=
SYSTEM_HTTPS_PORT=

# Which address those ports are published on. 127.0.0.1 is this machine only,
# which is what the README promises and what you want unless you know otherwise.
#
# Set 0.0.0.0 to reach the stack from other devices, or one interface address to
# reach it from one network. Two things need that: the OpenClaw node bridge, where
# a remote node or CLI connects in, and the Microsoft Teams endpoint. Everything
# else works without it.
#
# What it costs: every service behind the proxy becomes reachable from your
# network, including the ones with no password - OpenCode and the Swagger UI among
# them - and the OpenClaw gateway with admin rights. The proxy asserts the
# operator identity for whoever reaches it rather than authenticating anyone, so
# on an open port your network is the operator: a client sending
# Host: openclaw.localhost gets that identity, and the node bridge, which is the
# reason to open the port at all, is the same door. For a machine that is not
# yours alone, an SSH tunnel is the better answer; the README shows the command.
# And note the Teams endpoint is called from Microsoft's cloud rather than from
# your network, so opening this does not make that work on its own either.
#
# It has to be a literal address. `localhost` looks right and is not: compose
# resolves no names here, and the start refuses it before it stops anything.
SYSTEM_BIND_ADDRESS=127.0.0.1

# The internal address range the apps use to talk to each other. Leave it as it
# is unless it clashes with another network on your machine - if the start says
# the range is not available, put a free one here.
SYSTEM_NETWORK_SUBNET=10.99.0.0/24

# Which part of that range docker may hand out by itself. Addresses we pin have
# to sit outside it: docker allocates from the bottom up and the proxy starts
# last, so a pinned .2 was taken by another container before the proxy asked for
# it -- measured 2026-09-16, the start failed with "Address already in use".
SYSTEM_NETWORK_POOL=10.99.0.128/25

# How long the start waits when it needs you: a sign-in, or a deploy key that
# has to be registered before a repository can be cloned. This is the budget for
# the whole start, not per step: three unregistered deploy keys wait for this
# long between them, not three times this long. 0 means do not wait at all,
# which is what an unattended machine wants - it is not the same as waiting
# forever. Each waiting step also prints the command that skips just that one,
# and the deploy keys can all be skipped at once.
SYSTEM_SIGNIN_WAIT_SECONDS=900

# The address the reverse proxy takes inside that range, outside the pool above. It has to be fixed and
# it has to be known, because OpenClaw only accepts a forwarded request when it
# can tell the proxy apart from the client: it discards every hop it trusts, and
# whatever remains is the client. Trusting the whole range leaves nothing, and
# the request is refused with 403. Must lie inside SYSTEM_NETWORK_SUBNET and
# outside SYSTEM_NETWORK_POOL, which start.sh refuses if it does not.
#
# **Corrected 2026-10-05:** this said ".1 is docker's own gateway address, so .2
# is the first one free". With SYSTEM_NETWORK_POOL declared, docker puts the
# gateway at the *first address of the pool* instead -- measured on a running
# stack: `subnet=10.99.0.0/24 iprange=10.99.0.128/25 gateway=10.99.0.128`. So .1
# is free and .128 is not, which is the opposite of what this said. .2 is still a
# fine choice and is still outside the pool; the reason given for it was wrong.
SYSTEM_PROXY_IP=10.99.0.2


# =============================================================================
# 2. SERVICE SECRETS & CREDENTIALS - AUTOGENERATED ONCE IF VALUES ARE EMPTY
# =============================================================================

# Internal passwords the apps use to talk to each other. Leave them ALL blank —
# secure random values are created for you on the first save. You normally never
# need to look at or change anything in this section.

# --- Main database & API ---
DATABASE_PASSWORD=
# Leave blank. (The odd spelling here is intentional — please don't change it.)
POSTGREST_JWT_SECTET=

# --- pgAdmin (database admin tool) ---
PGADMIN_DATABASE_PASSWORD=

# --- OpenProject (project management) ---
OPENPROJECT_DATABASE_PASSWORD=
OPENPROJECT_SECRET_KEY_BASE=

# --- NextCloud (files & collaboration) ---
NEXTCLOUD_DATABASE_PASSWORD=
NEXTCLOUD_REDIS_PASSWORD=

# --- Hermes ---
HERMES_API_KEY=


# =============================================================================
# 3. SERVICE SECRETS & CREDENTIALS - USER CAN CHANGE ON FIRST RUN
# =============================================================================
# The email address shown for the pgAdmin database tool. You can change it, but
# it isn't used to sign in (that happens automatically), so the default is fine.
PGADMIN_DEFAULT_EMAIL=user@nocodenation.org


# =============================================================================
# 4. SERVICE SECRETS & CREDENTIALS - SCRIPTS GENERATE IT - DO NOT SHOW UI
# =============================================================================
# These are set up automatically by the installer. Please leave them exactly as
# they are.
API_KEY=generate_this_with_shell_script
PGADMIN_DEFAULT_PASSWORD=unused_pgadmin_uses_webserver_auth


# =============================================================================
# 5. LLM PROVIDER API KEYS (shared)
# =============================================================================
# To use a paid AI service, paste your key from that provider below. You only
# need the ones you already have an account with — leave the rest blank to skip
# them. These keys are shared by the AI tools in the stack.
#
# Don't have any keys? That's fine — you can run a free AI model on your own
# computer instead; see section 6.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=
# Only needed if your MiniMax account requires a group id.
MINIMAX_GROUP_ID=
ZAI_API_KEY=
AI_GATEWAY_API_KEY=
SYNTHETIC_API_KEY=
TOKENHUB_API_KEY=
LKEAP_API_KEY=


# =============================================================================
# 6. SELF-HOSTED LOCAL LLM
# =============================================================================

# Prefer a free AI model running on your own computer or local network instead
# of a paid service? Point the stack at it here. This works with apps like LM
# Studio or Ollama. Filling this in switches the local model on for both AI
# tools automatically; leave it blank to skip.

# The web address of your local AI server, including its port. For example:
#   http://local_llm:8080      (the name "local_llm" stands in for the IP below)
#   http://192.168.1.50:1234
# Don't add anything after the port number.
# Whatever this points at reads your messages in full before anything is masked -
# it is the trust boundary. Keep it on your own machine or network; a hosted service
# here would see the very data the proxy exists to protect.
LOCAL_LLM_API_BASE=
# The network address (IP) of the computer running that AI server.
LOCAL_LLM_HOST_IP=
# A key for your AI server — only if it needs one. Most home setups (like a
# default LM Studio) don't, so leave this blank.
LOCAL_LLM_API_KEY=


# =============================================================================
# 7. PRIVACY PROXY
# =============================================================================

# The Privacy Proxy is a stand-in AI model for your AI tools: they connect to it like a
# normal model, and it removes sensitive details — names, passwords, ID numbers — from
# every message before passing it on to the real AI service, then puts the real details
# back into the reply. Off by default. Set to 1 to turn it on; it then appears in your
# AI tools as the providers "privacy-openai" and "privacy-anthropic", each offering
# that service's own models. It signs in with the keys from section 5 (and the Claude
# subscription from section 8 when that is on) — nothing extra to enter here.
PRIVACY_PROXY_ENABLE=0
# Whether the Privacy Proxy is an extra choice or the only way to a cloud AI service.
# Read only when PRIVACY_PROXY_ENABLE=1.
#   opt-in  the privacy providers appear next to every other AI service you set up in
#           section 5 and 8; you pick a privacy model when you want protection (default).
#   only    your AI tools are offered the privacy providers and your local AI (section 6)
#           and nothing else. They no longer receive the keys of section 5, your Claude
#           login, or any GitHub Copilot, ChatGPT/Codex or Grok sign-in; the proxy keeps
#           what it needs. Stored sign-ins are set aside, not deleted, and return when you
#           switch back to opt-in. Services the proxy has no door for (OpenRouter, Google,
#           and the other keys of section 5) are not available in this mode.
# Any other value stops the start with an error. Changing it needs a restart.
PRIVACY_PROXY_ROUTING=opt-in # opt-in | only
# Which model on your local AI (section 6) does the cleaning: it reads every message for
# what word-matching cannot catch and rewords what would still identify someone. Blank =
# pick automatically. Any model your local AI serves works; recommended for an easy start:
# google/gemma-4-31b-it.
PRIVACY_PROXY_LOCAL_LLM_MODEL=
# The proxy remembers which real detail each stand-in replaced, so it can put the real
# details back into the reply. That memory is encrypted and stays on this computer. How
# long (in seconds) it keeps an entry; blank = keep everything. 604800 = one week.
PRIVACY_PROXY_VAULT_TTL=604800

# -----------------------------------------------------------------------------
# ADVANCED: SEPARATE JUDGE MODELS
# -----------------------------------------------------------------------------
# Optionally use other local models for the two judgements. Blank = use the model above.
#   JUDGE_MODEL      checks that a reworded message kept its meaning.
#   ADVERSARY_MODEL  rates how identifying a message still is and judges every outgoing
#                    message for trickery (attempts to hijack the AI or fish out secrets).
# Recommended for an easy start, not required: JUDGE_MODEL z-ai/glm-5.3-flash,
# ADVERSARY_MODEL minimax/minimax-m2.5.
PRIVACY_PROXY_JUDGE_MODEL=
PRIVACY_PROXY_ADVERSARY_MODEL=
# The proxy's settings page, where your company's own confidential terms and rules
# are defined, is at http://privacy.localhost:<web port>/policy/ui. It has no
# password: the stack only listens on this machine. If you ever expose the stack
# beyond it, put the password on the web proxy, not here.


# =============================================================================
# 8. OPENCLAW CONFIGURATION
# =============================================================================
# OpenClaw is the recommended AI assistant. Each option below connects an AI
# service you already pay for. Use 0 for off and 1 for on. You can turn on as
# many as you like and choose which one to use inside OpenClaw. After starting,
# you sign in to each from the dashboard.

# --- Use a Claude (Anthropic) subscription ---
# Turn on (1) to add Claude. Note: this one requires rebuilding the app after.
# When on, Claude models run through your Claude subscription (Claude CLI) and
# any ANTHROPIC_API_KEY above is ignored. With the Privacy Proxy on, your
# messages are cleaned before they reach Claude (chat only — Claude tools are
# not available on the cleaned route).
ENABLE_ANTHROPIC_CLAUDE_CODE=0

# --- Use GitHub Copilot ---
# Turn on (1) to add GitHub Copilot. Sign in from the dashboard when it starts.
ENABLE_GITHUB_COPILOT=0

# --- Use a ChatGPT subscription ---
# Turn on (1) to use your paid ChatGPT plan instead of an OpenAI key. Sign in
# with ChatGPT from the dashboard when it starts — no key needed.
# When on, OpenAI (GPT) chat runs through your ChatGPT/Codex subscription and
# any OPENAI_API_KEY above is ignored for chat. The key is still used for
# embeddings/RAG (the subscription can't embed), so keep it set if you use
# PDF ingest or vector search. Leave off (0) to bill OpenAI chat to the key too.
ENABLE_OPENAI_CODEX=0

# --- Use a Grok (xAI) subscription ---
# Turn on (1) to use your paid SuperGrok or X Premium plan instead of an xAI
# key. Sign in with Grok from the dashboard when it starts — no key needed.
ENABLE_XAI_GROK=0


# =============================================================================
# 9. Liquid AUTHENTICATION
# =============================================================================
# Login for Liquid (the data-flow app). Set a username AND password together to
# choose your own, or leave both blank to have random ones created for you. If
# you set a password, make it at least 12 characters.
LIQUID_USERNAME="liquid"
LIQUID_PASSWORD="liquidpassword"
# Password that protects Liquid's secure-connection certificates. The default is
# fine for most people.
LIQUID_KEYSTORE_PASSWORD=keystorepassword


# =============================================================================
# 10. IMAGE BUILD CONFIGURATION (used by build.sh)
# =============================================================================
#
# ADVANCED — most people can ignore this whole section and leave everything
# blank. It lets you add extra software into the apps when they are built, for
# example a tool that a custom workflow needs.
#
# Two settings below apply to all four built apps (Liquid, OpenCode, OpenClaw,
# Hermes):
#   - SYSTEM_DEPENDENCIES ......... extra system packages to install
#   - POST_INSTALLATION_COMMANDS .. extra setup commands to run afterwards
# Further down, each app has its own versions that can add to — or replace —
# these shared values.
#
# Notes:
#   - Separate multiple items with commas (spaces around them don't matter).
#   - Package names must be lowercase; an uppercase name will fail the build.

# SYSTEM_DEPENDENCIES
# -------------------
# Extra system packages added to every built app. These are background
# components that some tools need in order to run. Leave blank for none.
#
# Example: SYSTEM_DEPENDENCIES="poppler-utils, libgl1, ffmpeg"
SYSTEM_DEPENDENCIES=""

# POST_INSTALLATION_COMMANDS
# --------------------------
# Extra setup commands run in every built app, after the packages above are
# installed. Useful for adding extra tools. Leave blank for none.
#
# Example: POST_INSTALLATION_COMMANDS="playwright install-deps"
POST_INSTALLATION_COMMANDS=""

# -----------------------------------------------------------------------------
# PER-IMAGE OVERRIDES
# -----------------------------------------------------------------------------
# Each app also has its own copies of the two settings above, named with the
# app's prefix: LIQUID_, OPENCODE_, OPENCLAW_, HERMES_. Use these to give just
# one app something extra.
#
# Each one has a matching _MODE that decides how it combines with the shared
# values above:
#   add       (the default) use the shared values AND this app's extra values.
#   override  ignore the shared values and use only this app's values. (Set the
#             value to empty together with override to give this one app nothing
#             at all.)
#
# Example — add ffmpeg to Hermes only, on top of the shared list:
#   HERMES_SYSTEM_DEPENDENCIES="ffmpeg"
#   HERMES_SYSTEM_DEPENDENCIES_MODE="add"
#
# Example — give OpenCode its own list and ignore the shared one:
#   OPENCODE_SYSTEM_DEPENDENCIES="jq, ripgrep"
#   OPENCODE_SYSTEM_DEPENDENCIES_MODE="override"

# --- Liquid ---
LIQUID_SYSTEM_DEPENDENCIES=""
LIQUID_SYSTEM_DEPENDENCIES_MODE="add" # add | override
LIQUID_POST_INSTALLATION_COMMANDS=""
LIQUID_POST_INSTALLATION_COMMANDS_MODE="add" # add | override

# --- OpenCode ---
OPENCODE_SYSTEM_DEPENDENCIES=""
OPENCODE_SYSTEM_DEPENDENCIES_MODE="add" # add | override
OPENCODE_POST_INSTALLATION_COMMANDS=""
OPENCODE_POST_INSTALLATION_COMMANDS_MODE="add" # add | override

# --- OpenClaw ---
OPENCLAW_SYSTEM_DEPENDENCIES=""
OPENCLAW_SYSTEM_DEPENDENCIES_MODE="add" # add | override
OPENCLAW_POST_INSTALLATION_COMMANDS=""
OPENCLAW_POST_INSTALLATION_COMMANDS_MODE="add" # add | override

# --- Hermes ---
HERMES_SYSTEM_DEPENDENCIES=""
HERMES_SYSTEM_DEPENDENCIES_MODE="add" # add | override
HERMES_POST_INSTALLATION_COMMANDS=""
HERMES_POST_INSTALLATION_COMMANDS_MODE="add" # add | override


# =============================================================================
# 11. GIT INTEGRATION
# =============================================================================
#
# The AI agents (OpenClaw and OpenCode) keep their repositories in a shared
# workspace under ./volumes/repos, which you can browse on your own machine like
# any other folder.
#
# The two settings below decide whose name appears on the commits the agents
# make. Leave them blank and the agents commit under a generic name — that works
# fine, nothing needs to be filled in here to get started.

# GIT_USER_NAME
# -------------
# Name shown as the author of commits the agents create. Leave blank to use the
# built-in default.
#
# Example: GIT_USER_NAME="Liquid Upstart Agent"
GIT_USER_NAME=""

# GIT_USER_EMAIL
# --------------
# Email address recorded alongside the name above. It does not have to be a real
# mailbox. Leave blank to use the built-in default.
#
# Example: GIT_USER_EMAIL="agent@example.org"
GIT_USER_EMAIL=""

# GIT_REPOSITORIES
# ----------------
# The repositories the agents work with, separated by commas. Each entry is the
# repository's SSH address, then whether the agents may only read it or also
# write to it, then whether its main branch is protected or may be written
# direct — the three parts separated by a "|":
#
#   <ssh-url>|read or write|protected or direct
#
# Every repository listed here gets its own deploy key, which you register once
# in that repository's settings — the dashboard shows you each key — and is then
# cloned into ./volumes/repos when the stack starts. Web addresses starting with
# https:// are refused: the agents have SSH keys, not passwords. Leave blank if
# the agents should work only with repositories you create yourself.
#
# Example: GIT_REPOSITORIES="git@github.com:acme/skills.git|read|protected,git@github.com:acme/flows.git|write|direct"
GIT_REPOSITORIES=""

# =============================================================================
# 12. TEST HOOKS - DO NOT SHOW UI
# =============================================================================
# Leave this at 0.
#
# At 1 the nar_builder honours X-Liquid-Host and X-Nifi-Api-Probe-Version from
# any caller that gets past the vhost, which lets a test run point the builder's
# version probe at a stand-in Liquid. A run that sets it must set it back: left
# at 1, a caller can have the probe read its version from another host, and the
# build is then compiled against whatever that host reports.
#
# It was declared only in compose.yml until 2026-10-05, which is the minor this
# answers: `.env.example` is the contract, and a key a test run may flip belongs
# in it where an operator can see what it does. The marker in the banner above
# keeps it out of the configuration view -- it is documentation, not a setting
# anyone should reach for.
NAR_BUILDER_TEST_HOOKS=0

# =============================================================================
# 13. DEVELOPER OPTIONS - DO NOT SHOW UI
# =============================================================================
# For people working on the services themselves. Leave everything blank unless
# you have a source checkout of the service in question.

# Path to a local privacy-proxy checkout. Blank (the default) makes build.sh
# derive the image from the released ghcr.io/nocodenation/privacy-proxy:latest.
# Set it to build that base image from your own source first — the derived
# liquidupstart/privacy-proxy:latest is then built on top of it, so the Claude
# CLI switch and the rest of the stack behave exactly as in release mode.
# Absolute, or relative to this project's root. Requires PRIVACY_PROXY_ENABLE=1.
PRIVACY_PROXY_DEV_SRC=
# Which spaCy model tier that source build bakes in — a licensing choice, see
# pyproject.toml in the privacy-proxy checkout.
PRIVACY_PROXY_DEV_MODELS_EXTRA=models-permissive
# Address baked into the image's THIRD-PARTY-NOTICES as the written offer for
# third-party source. Only matters if you distribute what you build here.
PRIVACY_PROXY_DEV_SOURCE_OFFER_CONTACT=dev@localhost

# --- Privacy proxy debugging ---
# The proxy always runs its full chain: the local AI's second look, the rewording, the
# judgement of every outgoing message, and a pause that asks you when the risk stays
# high. These switch parts of it off or change how it reports, to debug one part on its
# own. Leave them as they are for real use.
#   GATE_MODE              ask = hold a message the judge rates high and ask you;
#                          log = record and send; block = refuse with 403; off = no check.
#   GATE_SCOPE             request = re-check the whole conversation on every request;
#                          turn = once per message you send.
#   MASK_SCAFFOLDING_ENABLE  1 = also mask the assistant's own instructions and tool texts.
#   SECURITY_JUDGE_ENABLE, LOCAL_LLM_ENABLE, SEMANTIC_ENABLE  0 = that part is off.
#   SEMANTIC_MODE          interactive = ask you; auto = send the safest version unasked.
#   LOCAL_LLM_TIMEOUT      the most one local AI call may take, in seconds, as a whole.
#   REWRITER_MODEL, RESPEC_MODEL  separate models for the rewording and for putting
#                          reworded details back into the reply; blank = the defaults.
#   CLAUDE_CLI_MODEL       the Claude model the cleaned Claude route uses by default.
#   LOG_LEVEL              DEBUG | INFO | WARNING | ERROR.
#   PRIVACY_GATEWAY_LLM_CAPTURE  a file path inside the container where every local AI
#                          call and every cleaned message sent to a cloud AI is logged.
PRIVACY_PROXY_GATE_MODE=ask # off | log | ask | block
PRIVACY_PROXY_GATE_SCOPE=request # request | turn
PRIVACY_PROXY_MASK_SCAFFOLDING_ENABLE=0
PRIVACY_PROXY_SECURITY_JUDGE_ENABLE=1
PRIVACY_PROXY_LOCAL_LLM_ENABLE=1
PRIVACY_PROXY_SEMANTIC_ENABLE=1
PRIVACY_PROXY_SEMANTIC_MODE=interactive # auto | interactive
PRIVACY_PROXY_LOCAL_LLM_TIMEOUT=180
PRIVACY_PROXY_REWRITER_MODEL=
PRIVACY_PROXY_RESPEC_MODEL=
PRIVACY_PROXY_CLAUDE_CLI_MODEL=
PRIVACY_PROXY_LOG_LEVEL=INFO # DEBUG | INFO | WARNING | ERROR
PRIVACY_GATEWAY_LLM_CAPTURE=
